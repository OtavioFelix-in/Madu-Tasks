{
  "expo": {
    "name": "MaduTasks",
    "slug": "madu-tasks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.otavio.madutasks",
      "adaptiveIcon": {
        "backgroundColor": "#E75480",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E75480"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O MaduTasks precisa acessar suas fotos para anexá-las às tarefas.",
          "cameraPermission": "O MaduTasks precisa da câmera para fotografar anotações e anexar às tarefas.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ]
  }
}
